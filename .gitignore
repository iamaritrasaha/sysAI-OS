# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local machine configuration — never portable, never shared. Each of
# these can legitimately contain an absolute path or other developer-
# specific detail (SysAI checkout location, local overrides).
.sysai_path
.env
.env.*

# Development-agent session artifacts — not part of the shipped project.
.claude/

# Runtime state generated by running the app: the persistent Runs
# database normally lives outside the repo (getApplicationSupportDirectory),
# but a workspace-scoped Run/Automation defaults to this repo's own root,
# so anything it writes under .sysai_os/ (Controlled Computer Use captures,
# OS-level desktop captures) must never be committed.
.sysai_os/
*.db
*.db-shm
*.db-wal

# Python
__pycache__/
*.pyc
.venv/
venv/

# Release artifacts and packaging
dist/
release/
*.tar.gz
*.deb
*.AppImage
*.rpm
install/staging/

# Runtime-generated files that must never enter git
*.pid
*.lock
*.sock

# Logs (runtime logs live in XDG dirs, but guard against accidental placement)
logs/
*.log

# Bridge test scratch directories
bridge/tests/tmp*/
bridge/tests/scratch*/
bridge/tests/__pycache__/
bridge/__pycache__/
bridge/capabilities/__pycache__/
bridge/policy/__pycache__/

# Smoke test and CI staging
.smoke_test/
.sysai-engine/
