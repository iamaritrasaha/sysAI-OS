# SysAI OS Runtime — systemd user service template
# Installed by: install/manage-service.sh install
# DO NOT edit this file manually — regenerate via manage-service.sh
[Unit]
Description=SysAI OS Persistent Runtime
Documentation=https://github.com/iamaritrasaha/sysAI-OS
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=@@VENV_PYTHON@@ @@RUNTIME_DIR@@/sysai_os_runtime.py --socket @@SOCKET_PATH@@
Restart=on-failure
RestartSec=5
# EX_CONFIG (78): configuration error — do not restart on bad config
RestartPreventExitStatus=78
KillMode=process
TimeoutStopSec=15

# Runtime environment
Environment=PYTHONUNBUFFERED=1
Environment=SYSAI_RUNTIME_SOCKET=@@SOCKET_PATH@@

# Logging goes to the journal and to the rotating file handler in sysai_logging.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sysai-os-runtime

[Install]
WantedBy=default.target
